# Copy to .env for local dev (never commit the real .env).

# Shared password gating the page. If unset, the app runs OPEN (dev only).
WORKBENCH_PASSWORD=changeme

# Flask session signing key. Generate a long random string, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=please-generate-a-long-random-hex-string

# eBird API key for species-name lookup. Defaults to eBird's public web key;
# get your own free key at https://ebird.org/api/keygen to be a good citizen.
EBIRD_API_KEY=jfekjedvescr

# Set to 0 only if your local Python can't validate Cornell's TLS chain.
ML_SSL_VERIFY=1
